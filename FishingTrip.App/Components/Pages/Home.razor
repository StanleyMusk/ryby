@page "/"
@inject TripManagementService TripManagementService

<PageTitle>Fishing Trip</PageTitle>

<section class="hero">
    <div class="hero-copy">
        <p class="eyebrow">Dashboard wyjazdu</p>
        <h1>@_dashboard.Title</h1>
        <p>Kontroluj sklad ekipy, zapisuj polowy i od razu widz, co faktycznie trafilo do bazy SQLite.</p>
        <div class="hero-actions">
            <a class="button primary" href="/catches/new">Dodaj polow</a>
            <a class="button secondary" href="/anglers/new">Dodaj wedkarza</a>
        </div>
    </div>
</section>

<section class="metric-grid">
    <article class="metric-card">
        <small>Wedkarze</small>
        <strong>@_dashboard.Anglers.Count</strong>
    </article>
    <article class="metric-card">
        <small>Polowy</small>
        <strong>@_dashboard.Catches.Count</strong>
    </article>
    <article class="metric-card">
        <small>Laczna waga</small>
        <strong>@_dashboard.Catches.Sum(item => item.WeightInKg).ToString("0.00") kg</strong>
    </article>
    <article class="metric-card">
        <small>Najwieksza ryba</small>
        <strong>@BiggestCatchLabel</strong>
    </article>
</section>

<section class="dashboard-grid">
    <article class="panel">
        <div class="panel-title">
            <div>
                <p class="eyebrow">Lista</p>
                <h2>Wedkarze</h2>
            </div>
            <a class="text-link" href="/anglers">Zobacz</a>
        </div>

        <div class="person-list">
            @foreach (var angler in _dashboard.Anglers.Take(6))
            {
                <div class="person-row">
                    <span>@GetInitials(angler.DisplayName)</span>
                    <p>@angler.DisplayName</p>
                </div>
            }
        </div>
    </article>

    <article class="panel">
        <div class="panel-title">
            <div>
                <p class="eyebrow">Ostatnie</p>
                <h2>Polowy</h2>
            </div>
            <a class="text-link" href="/catches">Zobacz</a>
        </div>

        <div class="catch-list">
            @foreach (var item in _dashboard.Catches.Take(5))
            {
                <div class="catch-row">
                    <div>
                        <strong>@item.Species</strong>
                        <small>@item.AnglerName</small>
                    </div>
                    <span>@item.WeightInKg.ToString("0.00") kg</span>
                </div>
            }
        </div>
    </article>
</section>

@code {
    private TripDashboard _dashboard = new("Ladowanie...", [], []);

    private string BiggestCatchLabel => _dashboard.Catches.Any()
        ? $"{_dashboard.Catches.Max(item => item.WeightInKg):0.00} kg"
        : "0.00 kg";

    protected override void OnInitialized()
    {
        _dashboard = TripManagementService.GetDashboard();
    }

    private static string GetInitials(string displayName)
    {
        var parts = displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Take(2).Select(part => char.ToUpperInvariant(part[0])));
    }
}
