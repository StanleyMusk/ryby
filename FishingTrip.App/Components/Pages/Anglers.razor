@page "/anglers"
@inject TripManagementService TripManagementService

<PageTitle>Wedkarze</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">Baza</p>
        <h1>Wedkarze</h1>
    </div>
    <a class="button primary" href="/anglers/new">Dodaj wedkarza</a>
</section>

<section class="panel">
    <div class="people-grid">
        @foreach (var angler in _dashboard.Anglers)
        {
            <article class="person-card">
                <span>@GetInitials(angler.DisplayName)</span>
                <h2>@angler.DisplayName</h2>
                <a class="text-link" href="@($"/reports/anglers/{angler.Id}")">Raport wedkarza</a>
            </article>
        }
    </div>
</section>

@code {
    private TripDashboard _dashboard = new("Ladowanie...", [], []);

    protected override void OnInitialized()
    {
        _dashboard = TripManagementService.GetDashboard();
    }

    private static string GetInitials(string displayName)
    {
        var parts = displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Take(2).Select(part => char.ToUpperInvariant(part[0])));
    }
}
