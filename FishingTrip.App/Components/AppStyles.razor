<style>
    :root {
        --page: #07110d;
        --panel: #12231d;
        --panel-soft: #193029;
        --ink: #f1f7f3;
        --muted: #a9bdb3;
        --line: rgba(218, 235, 226, 0.16);
        --green: #4fca8a;
        --green-dark: #2e8f65;
        --amber: #e6b85d;
        --blue: #7ec8de;
        --danger: #ff9187;
        --shadow: 0 18px 48px rgba(0, 0, 0, 0.28);
    }

    * {
        box-sizing: border-box;
    }

    html,
    body {
        margin: 0;
        min-height: 100%;
        background: linear-gradient(135deg, #07110d 0%, #0d1f18 52%, #061511 100%);
        color: var(--ink);
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    }

    body {
        min-height: 100vh;
    }

    a {
        color: inherit;
        text-decoration: none;
    }

    .app-shell {
        display: grid;
        grid-template-columns: 264px minmax(0, 1fr);
        min-height: 100vh;
    }

    .sidebar {
        position: sticky;
        top: 0;
        height: 100vh;
        padding: 22px;
        border-right: 1px solid var(--line);
        background: #07100d;
    }

    .brand {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 28px;
    }

    .brand-mark {
        display: grid;
        width: 44px;
        height: 44px;
        place-items: center;
        border-radius: 8px;
        background: var(--amber);
        color: #132019;
        font-weight: 950;
    }

    .brand strong,
    .brand small {
        display: block;
    }

    .brand small {
        margin-top: 2px;
        color: var(--muted);
        font-size: 0.78rem;
    }

    .nav {
        display: grid;
        gap: 8px;
    }

    .nav a {
        padding: 12px 13px;
        border: 1px solid transparent;
        border-radius: 8px;
        color: #d8e8df;
        font-weight: 750;
    }

    .nav a:hover,
    .nav a.active {
        border-color: var(--line);
        background: rgba(255, 255, 255, 0.08);
        color: #fff;
    }

    .content {
        min-width: 0;
        padding: 30px;
    }

    .hero {
        min-height: 330px;
        display: flex;
        align-items: flex-end;
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: linear-gradient(90deg, rgba(5, 13, 10, 0.96), rgba(5, 13, 10, 0.38)),
            url("/images/lake-dashboard.png") center / cover;
        box-shadow: var(--shadow);
    }

    .hero-copy {
        width: min(700px, 100%);
        padding: 38px;
    }

    .eyebrow {
        margin: 0 0 8px;
        color: var(--amber);
        font-size: 0.76rem;
        font-weight: 950;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    h1,
    h2,
    p {
        margin-top: 0;
    }

    h1 {
        margin-bottom: 10px;
        font-size: clamp(2rem, 4vw, 3.6rem);
        line-height: 1.04;
    }

    h2 {
        margin-bottom: 0;
        font-size: 1.16rem;
    }

    .hero p {
        max-width: 620px;
        margin-bottom: 0;
        color: #dcebe4;
        font-size: 1.04rem;
        line-height: 1.6;
    }

    .hero-actions,
    .form-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 22px;
    }

    .button {
        display: inline-flex;
        min-height: 42px;
        align-items: center;
        justify-content: center;
        border: 1px solid transparent;
        border-radius: 8px;
        padding: 10px 15px;
        font: inherit;
        font-weight: 850;
        cursor: pointer;
    }

    .button.primary {
        background: var(--green);
        color: #07120e;
        box-shadow: 0 12px 26px rgba(79, 202, 138, 0.16);
    }

    .button.primary:hover {
        background: #7ee0ad;
    }

    .button.secondary,
    .button.ghost {
        border-color: var(--line);
        background: rgba(255, 255, 255, 0.08);
        color: var(--ink);
    }

    .button.danger {
        border-color: rgba(255, 145, 135, 0.36);
        background: rgba(255, 145, 135, 0.12);
        color: var(--danger);
    }

    .button.danger:hover {
        background: rgba(255, 145, 135, 0.22);
    }

    .metric-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
        margin-top: 18px;
    }

    .dashboard-grid {
        display: grid;
        grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
        gap: 16px;
        margin-top: 16px;
    }

    .admin-grid {
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }

    .admin-actions {
        display: inline-flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .metric-card,
    .panel {
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--panel);
        box-shadow: 0 14px 36px rgba(0, 0, 0, 0.22);
    }

    .metric-card {
        padding: 18px;
    }

    .metric-card small {
        display: block;
        margin-bottom: 8px;
        color: var(--muted);
        font-weight: 850;
    }

    .metric-card strong {
        color: #fff;
        font-size: 1.55rem;
    }

    .panel {
        padding: 20px;
    }

    .panel-title,
    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
    }

    .page-header {
        margin-bottom: 18px;
        padding: 18px 20px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--panel);
    }

    .page-header h1 {
        margin-bottom: 0;
    }

    .text-link {
        color: var(--green);
        font-weight: 850;
    }

    .person-list,
    .catch-list {
        display: grid;
        gap: 10px;
        margin-top: 16px;
    }

    .person-row,
    .catch-row,
    .person-card {
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--panel-soft);
    }

    .person-row,
    .catch-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 12px;
    }

    .person-row span,
    .person-card span {
        display: grid;
        width: 38px;
        height: 38px;
        flex: 0 0 auto;
        place-items: center;
        border-radius: 8px;
        background: rgba(79, 202, 138, 0.18);
        color: #98efbf;
        font-weight: 950;
    }

    .person-row p,
    .catch-row small {
        margin: 0;
    }

    .catch-row strong,
    .catch-row small {
        display: block;
    }

    .catch-row small {
        margin-top: 3px;
        color: var(--muted);
    }

    .catch-row span {
        color: var(--blue);
        font-weight: 950;
        white-space: nowrap;
    }

    .people-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 12px;
    }

    .person-card {
        padding: 16px;
    }

    .person-card h2 {
        margin-top: 12px;
    }

    .person-card .text-link {
        display: inline-flex;
        margin-top: 12px;
    }

    .stat-list,
    .ranking-list,
    .species-list {
        display: grid;
        gap: 10px;
        margin-top: 16px;
    }

    .stat-list div,
    .ranking-row,
    .species-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--panel-soft);
        padding: 12px;
    }

    .stat-list span,
    .ranking-row small,
    .species-row small {
        display: block;
        color: var(--muted);
        font-size: 0.86rem;
        font-weight: 800;
    }

    .stat-list strong,
    .ranking-row strong,
    .species-row strong {
        color: #fff;
    }

    .ranking-row {
        color: var(--ink);
    }

    .rank-position {
        display: grid;
        width: 34px;
        height: 34px;
        flex: 0 0 auto;
        place-items: center;
        border-radius: 8px;
        background: rgba(230, 184, 93, 0.18);
        color: var(--amber);
        font-weight: 950;
    }

    .rank-score,
    .species-row > span:last-child {
        color: var(--blue);
        font-weight: 950;
        white-space: nowrap;
    }

    .classification-tabs {
        display: inline-grid;
        grid-template-columns: repeat(3, minmax(120px, 1fr));
        gap: 4px;
        max-width: 560px;
        width: 100%;
        margin-top: 4px;
        padding: 4px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.06);
    }

    .classification-tab {
        min-height: 42px;
        border: 0;
        border-radius: 6px;
        background: transparent;
        color: var(--muted);
        cursor: pointer;
        font: inherit;
        font-weight: 900;
    }

    .classification-tab:hover,
    .classification-tab:focus-visible {
        color: var(--ink);
        background: rgba(255, 255, 255, 0.08);
        outline: none;
    }

    .classification-tab.active {
        color: #10221c;
        background: var(--green);
        box-shadow: 0 10px 24px rgba(75, 184, 128, 0.26);
    }

    .report-table {
        margin-top: 16px;
    }

    .form-shell {
        max-width: 900px;
    }

    .form-panel {
        padding: 24px;
    }

    .field-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

    label {
        display: grid;
        gap: 7px;
    }

    label span {
        color: var(--muted);
        font-size: 0.88rem;
        font-weight: 850;
    }

    input,
    select,
    textarea {
        width: 100%;
        border: 1px solid rgba(210, 232, 220, 0.24);
        border-radius: 8px;
        padding: 11px 12px;
        background: #07120e;
        color: var(--ink);
        font: inherit;
    }

    select option {
        background: #12231d;
        color: var(--ink);
    }

    textarea {
        min-height: 96px;
        resize: vertical;
    }

    input:focus,
    select:focus,
    textarea:focus {
        outline: 3px solid rgba(126, 200, 222, 0.18);
        border-color: var(--blue);
    }

    .wide-field {
        grid-column: 1 / -1;
    }

    .validation-errors {
        margin: 0 0 14px;
        padding: 12px 14px 12px 30px;
        border: 1px solid rgba(255, 145, 135, 0.4);
        border-radius: 8px;
        background: rgba(160, 58, 50, 0.12);
        color: var(--danger);
    }

    .empty-state {
        padding: 18px;
        border: 1px dashed rgba(210, 232, 220, 0.25);
        border-radius: 8px;
        background: var(--panel-soft);
    }

    .empty-state p {
        color: var(--muted);
    }

    .admin-message {
        margin-bottom: 16px;
        padding: 12px 14px;
        border: 1px solid rgba(126, 200, 222, 0.28);
        border-radius: 8px;
        background: rgba(126, 200, 222, 0.1);
        color: var(--blue);
        font-weight: 850;
    }

    .table-wrap {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th,
    td {
        padding: 13px 10px;
        border-bottom: 1px solid var(--line);
        text-align: left;
        white-space: nowrap;
    }

    thead th {
        color: var(--muted);
        font-size: 0.86rem;
        font-weight: 950;
    }

    tbody tr:hover {
        background: rgba(255, 255, 255, 0.055);
    }

    @@media (max-width: 980px) {
        .app-shell {
            grid-template-columns: 1fr;
        }

        .sidebar {
            position: static;
            height: auto;
        }

        .nav {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .metric-grid,
        .dashboard-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 680px) {
        .content {
            padding: 16px;
        }

        .hero {
            min-height: 420px;
        }

        .hero-copy {
            padding: 24px;
        }

        .metric-grid,
        .dashboard-grid,
        .field-grid {
            grid-template-columns: 1fr;
        }

        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .wide-field {
            grid-column: auto;
        }
    }
</style>
